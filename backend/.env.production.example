DJANGO_SETTINGS_MODULE=backend.settings_production
DEBUG=False
# Supply a freshly generated secret via the deployment environment.
SECRET_KEY=
ALLOWED_HOSTS=api.example.com
DB_ENGINE=postgres
DB_NAME=diagrama
DB_USER=app
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
# Private persistent directory, never exposed by the web server.
GENERADOR_TMP_DIR=/var/lib/uml/generados
# Set true only after configuring the trusted HTTPS proxy.
TRUST_PROXY_SSL_HEADER=false
