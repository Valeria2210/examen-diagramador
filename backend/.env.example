DEBUG=True
SECRET_KEY=cambia-esta-clave-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=postgres
DB_NAME=diagrama
DB_USER=valeria
DB_PASSWORD=123456789
DB_HOST=localhost
DB_PORT=5432
# IA: define tu clave solo en backend/.env; requiere saldo en la cuenta API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Entrega privada de proyectos generados (sin publicar este directorio como MEDIA)
GENERADOR_ZIP_TTL_HORAS=24
GENERADOR_RATE=10/min
GENERADOR_MAX_ATRIBUTOS=200
GENERADOR_MAX_RELACIONES=500
