package {{ paquete_base }}.repositorios;

import {{ paquete_base }}.entidades.{{ entidad.nombre }};
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Modifying;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import java.util.UUID;
{% if entidad.relaciones | rejectattr('many') | list %}
import org.springframework.data.jpa.repository.EntityGraph;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.Pageable;
import java.util.List;
import java.util.Optional;
{% endif %}

public interface {{ entidad.nombre }}Repository extends JpaRepository<{{ entidad.nombre }}, {{ entidad.pk.tipo }}> {
    @Modifying(flushAutomatically = true, clearAutomatically = true)
    @Query("delete from {{ entidad.nombre }} e where e.{{ entidad.pk.nombre }} = :id")
    int eliminarPorId(@Param("id") {{ entidad.pk.tipo }} id);

{% if entidad.relaciones | rejectattr('many') | list %}
    @Override
    @EntityGraph(attributePaths = { {% for rel in entidad.relaciones if not rel.many %}"{{ rel.campo }}"{{ ', ' if not loop.last else '' }}{% endfor %} })
    List<{{ entidad.nombre }}> findAll();

    @Override
    @EntityGraph(attributePaths = { {% for rel in entidad.relaciones if not rel.many %}"{{ rel.campo }}"{{ ', ' if not loop.last else '' }}{% endfor %} })
    Optional<{{ entidad.nombre }}> findById({{ entidad.pk.tipo }} id);

    @Override
    @EntityGraph(attributePaths = { {% for rel in entidad.relaciones if not rel.many %}"{{ rel.campo }}"{{ ', ' if not loop.last else '' }}{% endfor %} })
    Page<{{ entidad.nombre }}> findAll(Pageable pageable);
{% endif %}
}
