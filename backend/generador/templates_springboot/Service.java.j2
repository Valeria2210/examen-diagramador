            var ids = new LinkedHashSet<>(dto.get{{ rel.getter }}Ids());
            var values = {{ rel.repo_var }}.findAllById(ids);
            var byId = values.stream().collect(Collectors.toMap(value -> value.get{{ rel.id_getter }}(), value -> value));
            for (var id : ids) {
