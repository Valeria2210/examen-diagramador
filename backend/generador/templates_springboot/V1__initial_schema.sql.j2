CREATE TABLE app_users (
    id UUID PRIMARY KEY,
    username VARCHAR(100) NOT NULL UNIQUE,
    password_hash VARCHAR(100) NOT NULL,
    role VARCHAR(20) NOT NULL,
    active BOOLEAN NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL
);

CREATE TABLE auth_tokens (
    id UUID PRIMARY KEY,
    token_hash VARCHAR(64) NOT NULL UNIQUE,
    user_id UUID NOT NULL REFERENCES app_users(id) ON DELETE CASCADE,
    expires_at TIMESTAMP WITH TIME ZONE NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE NOT NULL
);
CREATE INDEX idx_auth_tokens_expires ON auth_tokens(expires_at);

{% for entidad in entidades %}
CREATE TABLE {{ entidad.tabla }} (
{% for attr in entidad.atributos %}
    {{ attr.columna }} {{ attr.sql_tipo }}{% if attr.pk and attr.autogenerado and attr.tipo in ('Long', 'Integer') %} GENERATED BY DEFAULT AS IDENTITY{% endif %}{% if attr.pk or not attr.nullable %} NOT NULL{% endif %}{% if attr.pk %} PRIMARY KEY{% endif %}{% if attr.unico and not attr.pk %} UNIQUE{% endif %}{{ ',' if not loop.last else '' }}
{% endfor %}
);

{% endfor %}
{% for entidad in entidades %}
{% for rel in entidad.relaciones if rel.owner and not rel.many %}
ALTER TABLE {{ entidad.tabla }} ADD COLUMN {{ rel.join }} {{ rel.id_sql_tipo }}{% if rel.required %} NOT NULL{% endif %}{% if rel.tipo == 'OneToOne' %} UNIQUE{% endif %};
ALTER TABLE {{ entidad.tabla }} ADD FOREIGN KEY ({{ rel.join }}) REFERENCES {{ rel.otra_tabla }}({{ rel.otra_pk_columna }});
{% endfor %}
{% for rel in entidad.relaciones if rel.owner and rel.many %}
CREATE TABLE {{ rel.join_table }} (
    source_id {{ entidad.pk.sql_tipo }} NOT NULL REFERENCES {{ entidad.tabla }}({{ entidad.pk.columna }}) ON DELETE CASCADE,
    target_id {{ rel.id_sql_tipo }} NOT NULL REFERENCES {{ rel.otra_tabla }}({{ rel.otra_pk_columna }}),
    PRIMARY KEY (source_id, target_id)
);
{% endfor %}
{% endfor %}
