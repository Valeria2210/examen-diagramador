package {{ paquete_base }}.seguridad;

import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.Pattern;
import jakarta.validation.constraints.Size;
import java.time.Instant;

public final class AuthModels {
    private AuthModels() {}

    public record RegisterRequest(
            @NotBlank @Size(min = 3, max = 100)
            @Pattern(regexp = "^[A-Za-z0-9._-]+$", message = "usa letras, números, punto, guion o guion bajo")
            String username,
            @NotBlank @Size(min = 10, max = 72) String password) {}

    public record LoginRequest(@NotBlank String username, @NotBlank String password) {}

    public record TokenResponse(String token, String tokenType, Instant expiresAt, String username, UserRole role) {}

    public record UserResponse(String username, UserRole role) {}
}
